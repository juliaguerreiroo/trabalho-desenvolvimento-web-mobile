// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../prisma/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  createdAt    DateTime @default(now())
  profile      Profile?
  passwordHash String   @default("$2b$10$21V92Zk9GwSDXAdgqRr/oul1AN7/roDDo.q/eqCW35OdH1wUQDg9O")
  role         String   @default("USER")
  purchases    Purchase[]
  createdGames Game[]
  subscriptions PlanSubscription[]
}

model Profile {
  id        Int       @id @default(autoincrement())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int       @unique
  fullName  String
  birthDate DateTime?
  avatarUrl String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Plan {
  id            Int    @id @default(autoincrement())
  name          String
  price         Float
  maxGames      Int
  minDiscount   Float  @default(5)
  maxDiscount   Float
  subscriptions PlanSubscription[]
  games         PlanGame[]
}

model PlanGame {
  plan   Plan @relation(fields: [planId], references: [id], onDelete: Cascade)
  planId Int
  game   Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  gameId Int

  @@id([planId, gameId])
}

model PlanSubscription {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  plan      Plan     @relation(fields: [planId], references: [id])
  planId    Int
  startedAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId, expiresAt])
}

model Library {
  id     Int              @id @default(autoincrement())
  userId Int              @unique
  games  gamesOnLibrary[]
}

model Game {
  id              Int              @id @default(autoincrement())
  name            String
  price           Float            @default(0)
  currentDiscount Float            @default(0)
  discountUpdatedAt DateTime?
  ownerId         Int
  owner           User             @relation(fields: [ownerId], references: [id])
  libraries       gamesOnLibrary[]
  categories      Category[]
  gamesOnPurchase gamesPurchased[]
  plans           PlanGame[]

  @@index([ownerId])
}

model gamesOnLibrary {
  library    Library @relation(fields: [libraryId], references: [id])
  libraryId  Int
  game       Game    @relation(fields: [gameId], references: [id])
  gameId     Int
  timePlayed Int

  @@id([libraryId, gameId]) // Chave primária composta
}

model Category {
  id    Int    @id @default(autoincrement())
  name  String
  games Game[]
}

model Purchase {
  id         Int              @id @default(autoincrement())
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     Int
  totalPrice Float
  data       DateTime         @default(now())
  purchases  gamesPurchased[]
}

model gamesPurchased {
  purchase         Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  purchaseId       Int
  game             Game     @relation(fields: [gameId], references: [id])
  gameId           Int
  acquisitionPrice Float
  discount         Float

  @@id([purchaseId, gameId])
}
